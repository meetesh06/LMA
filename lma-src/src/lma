#!/bin/bash
# Entry point for 'sudo lma'. Works out who invoked sudo and hands over to lma.py.
# Locking is done inside lma.py, only around the actual allocation change, so one
# user sitting in the menu does not block everyone else.

INVOKING_USER_UID=${SUDO_UID:-$(id -u "$LOGNAME" 2>/dev/null)}

if [ -z "$INVOKING_USER_UID" ] || [ "$INVOKING_USER_UID" -eq 0 ]; then
    echo "ERROR: Could not determine the invoking (non-root) user. Run this as: sudo lma"
    exit 1
fi

exec /usr/bin/python3 -I /usr/lib/lma/lma.py "$INVOKING_USER_UID" "$@"
