#!/bin/sh
set -e

PKG="lma"
# The uninstaller is placed here
LIB_DIR="/usr/lib/$PKG"

case "$1" in
    # This block now handles BOTH 'remove' and 'purge'
    remove|purge)
        echo "[$PKG] Package files removed. Running custom uninstall script for cleanup..."

        echo "Cleaning up cgroup slice overrides..."
        rm -f /etc/systemd/system/init.scope.d/40-cpulimit.conf
        rm -f /etc/systemd/system/system.slice.d/40-cpulimit.conf
        rm -f /etc/systemd/system/user.slice.d/40-cpulimit.conf
        rm -f /etc/systemd/system/user-.slice.d/40-cpulimit.conf

        # --- 2. Remove all dynamic user slice reservations ---

        SLICE_DIR="/etc/systemd/system/" 
        echo "Removing dynamic user slice reservations..."

        # Only remove LMA's own drop-in; other admin drop-ins in user-UID.slice.d are kept.
        rm -f "$SLICE_DIR"user-*.slice.d/90-AllowedCPUs.conf

        # --- 3. Other Configuration Cleanup ---

        echo "Cleaning up GRUB configuration..."
        rm -f /etc/default/grub.d/cgroup.cfg

        echo "Removing sudoers directive..."
        rm -f /etc/sudoers.d/lma

        echo "Removing systemd service file..."
        systemctl disable lma-reset.service 2>/dev/null || true
        rm -f /etc/systemd/system/lma-reset.service

        # --- 4. Reload Daemon and Restart Services ---

        echo "Reloading systemd daemon and restarting slices..."
        systemctl daemon-reload || true
        systemctl restart user.slice || true

        if command -v update-grub >/dev/null 2>&1; then
            update-grub || true
        fi

        rm -f /run/lma.lock
        if [ "$1" = "purge" ]; then
            echo "Removing /etc/lma ..."
            rm -rf /etc/lma
        fi
        
        # --- 5. Cleanup extra files ---
        echo "[$PKG] Removing internal library directory: $LIB_DIR"
        rm -rf "$LIB_DIR" || true 
    ;;

    # ... (Other actions remain the same) ...
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Do nothing on these actions
    ;;

    *)
        echo "[$PKG] postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
